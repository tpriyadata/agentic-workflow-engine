# Copy to .env and fill in.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_MODEL=claude-sonnet-4-6

# --- Persistence ---
# When running via docker-compose, this is overridden to point at the
# `postgres` service automatically -- only needed for local (non-docker) runs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_scaffold

# --- HITL ---
HITL_APPROVAL_TIMEOUT_SECONDS=604800
HITL_REQUIRE_APPROVER_ID=true

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Leave blank to disable auth locally. Set this for anything beyond local dev.
API_KEY=
